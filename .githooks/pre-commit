#!/usr/bin/env bash
# The checks that are quick enough to run at every commit; the tests are for before a push.
#
#   git config core.hooksPath .githooks     once in each clone turns this on
#   git commit --no-verify                  skips it (for work in progress on a research branch)
#
# Clippy looks at the files as they are in the working tree, not only at what is staged.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing to check when no Rust file, and not the manifest, is part of the commit.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
  exit 0
fi

echo "pre-commit: cargo clippy --all-targets -- -D warnings" >&2
cargo clippy --all-targets --quiet -- -D warnings
