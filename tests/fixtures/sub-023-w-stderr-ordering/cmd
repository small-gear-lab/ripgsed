echo ---
sed 's/o/0/w /dev/stderr' a.txt 2>&1 >/dev/null
echo ---
sed 's/o/0/w /dev/stderr' a.txt 2>/dev/null
echo ---
sed 's/o/0/pw /dev/stderr' a.txt 2>&1
