for re in 'a{32767}' 'a{32768}' 'a{256}' 'a{0}' 'a{,2}' 'a{,}' 'a{}' 'a{2,1}' 'a{1' 'a{1,2' 'a{x}' 'a{1}{2}' 'a{1}*' 'a{1,2}{3,4}' 'a{ 1}' '{1}' 'a|{1}' '(a){0}' 'a{0}b' 'a{1}{0}'; do
