for re in 'a\{32767\}' 'a\{32768\}' 'a\{65535\}' 'a\{65536\}' 'a\{256\}' 'a\{255\}' 'a\{0\}' 'a\{0,0\}' 'a\{1,32768\}' 'a\{32767,\}' 'a\{32768,\}' 'a\{2,1\}' 'a\{,2\}' 'a\{,\}' 'a\{\}' 'a\{1' 'a\{1,' 'a\{1,2' 'a\{x\}' 'a\{1x\}' 'a\{-1\}' 'a\{1,-2\}' 'a\{99999999999\}' 'a\{1\}\{2\}' 'a*\{2\}' '\(a\{2\}\)\{3\}' 'a\{1\}*' 'a\{ 1\}'; do
