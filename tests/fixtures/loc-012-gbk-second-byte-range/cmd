mk() { mkdir -p "$PWD/loc"; localedef -f "$1" -i "$2" "$PWD/loc/$3" > /dev/null 2>&1; }
export LOCPATH=$PWD/loc LANGUAGE=C
mk GBK zh_CN zh_CN.GBK
export LC_ALL=zh_CN.GBK
# CHINA (0xd6 0xd0), a character whose second byte is @ (0x81 0x40), and one whose second byte is a backslash (0x81 0x5c)
Z=$(printf '\326\320')
AT=$(printf '\201\100')
BS=$(printf '\201\134')
printf '%s\n' "${Z}${AT}${BS}a" | sed 's/./[&]/g' | od -An -c
printf '%s\n' "${AT}" | sed 's/@/x/' | od -An -c
printf '%s\n' "${BS}" | sed 's/\\/x/' | od -An -c
printf '%s\n' "${Z}${AT}" | sed 's/[[:alpha:]]/X/g' | od -An -c
printf '%s\n' "${Z}${AT}a_" | sed 's/\w/X/g' | od -An -c
printf '%s\n' "${Z}b" | sed 's/\b/|/g' | od -An -c
printf '%s\n' "${Z}${Z}" | sed 's/'"${Z}"'/X/2'
printf '%s\n' "${Z}${AT}" | sed 's/[^a]/X/g'
printf '%s\n' "${Z}" | sed 'y/'"${Z}"'/a/'
printf '%s\n' "${Z}${Z}" | sed 's/^\(.\)\1$/same/'
rm -rf loc
